{
  "preset": "ts-jest",
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "clearMocks": true,
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "commonjs",
          "moduleResolution": "node10",
          "isolatedModules": true
        }
      }
    ]
  },
  "coverageThreshold": {
    "global": {
      "statements": 90,
      "branches": 84,
      "functions": 95,
      "lines": 92
    }
  }
}
