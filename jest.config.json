{
  "preset": "ts-jest",
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "clearMocks": true,
  "transform": {
    "^.+\\.tsx?$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "commonjs",
          "moduleResolution": "node10",
          "isolatedModules": true
        }
      }
    ]
  }
}
